<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<AssemblyName>WhereTheyGo</AssemblyName>
		<RootNamespace>WhereTheyGo</RootNamespace>
		<Authors>maxblan</Authors>
	
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<!--Checked arithmetic is deliberately OFF for the mod, and only for the mod.
		    ExtractTripsJob and ColorBuildingsJob are Burst-compiled and run per citizen
		    and per building; Burst does not support throwing, so an overflow check there
		    is either a compile failure or an abort, and the branch costs vectorization.
		    The test project (Directory.Build.props) keeps it on, and the pure math files
		    are compiled into BOTH, so overflow is still checked where it is reachable.-->
		<CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>

		<!--Pins the analyzer package so a locked-mode restore (make strict) resolves
		    the same version on every machine.-->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>
	
	<!--The game's modding toolchain. That lookup reads a Windows USER environment
	    variable, which only a Windows process can see: from a Linux process (an editor's
	    design-time build under WSL) it returns nothing, and the two Imports below used to
	    expand to a missing "\Mod.props" and fail the project before it could even be
	    restored. Guarding them instead lets the project evaluate everywhere, and the
	    fallback further down gives an editor enough to bind against.-->
	<PropertyGroup>
		<ModToolPath>$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))</ModToolPath>
		<HasModToolchain>false</HasModToolchain>
		<!--BOTH files, because both are imported below: a directory holding only
		    Mod.props would otherwise fail on the second import with a raw MSB4019 and
		    none of the guidance CheckModToolchain gives.-->
		<HasModToolchain Condition="Exists('$(ModToolPath)\Mod.props') AND Exists('$(ModToolPath)\Mod.targets')">true</HasModToolchain>
	</PropertyGroup>

	<!--Imports must be after PropertyGroup block-->
	<Import Project="$(ModToolPath)\Mod.props" Condition="'$(HasModToolchain)' == 'true'" />
	<Import Project="$(ModToolPath)\Mod.targets" Condition="'$(HasModToolchain)' == 'true'" />

	<!--EDITOR ONLY, and never a mod: what Mod.props would have set, plus the game's own
	    assemblies, so a design-time build resolves every type instead of reporting a
	    CS0246 on each one. It deliberately does NOT reproduce a real build: Mod.props also
	    brings the Entities source generators and Mod.targets the post-processor and the
	    deploy, so an output produced this way is unshippable. CheckModToolchain below says
	    so out loud. The Managed folder is looked up the way Mod.props looks it up, at the
	    same two default install locations, seen through the WSL mount.-->
	<PropertyGroup Condition="'$(HasModToolchain)' != 'true'">
		<TargetFramework>net48</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<WslSteamManagedPath>/mnt/c/Program Files (x86)/Steam/steamapps/common/Cities Skylines II/Cities2_Data/Managed</WslSteamManagedPath>
		<WslXboxManagedPath>/mnt/c/XboxGames/Cities- Skylines II - PC Edition/Content/Cities2_Data/Managed</WslXboxManagedPath>
		<ManagedPath Condition="'$(ManagedPath)' == '' AND Exists('$(CSII_MANAGEDPATH)/Game.dll')">$(CSII_MANAGEDPATH)</ManagedPath>
		<ManagedPath Condition="'$(ManagedPath)' == '' AND Exists('$(WslSteamManagedPath)/Game.dll')">$(WslSteamManagedPath)</ManagedPath>
		<ManagedPath Condition="'$(ManagedPath)' == '' AND Exists('$(WslXboxManagedPath)/Game.dll')">$(WslXboxManagedPath)</ManagedPath>
		<AssemblySearchPaths>$(AssemblySearchPaths);$(ManagedPath)</AssemblySearchPaths>
		<!--Microsoft.NET.Sdk.props copies AssemblySearchPaths into this one BEFORE this
		    file's body runs, so the Managed folder has to be appended here as well or
		    the design-time resolver - the one this whole block exists for - searches
		    without it.-->
		<DesignTimeAssemblySearchPaths>$(DesignTimeAssemblySearchPaths);$(ManagedPath)</DesignTimeAssemblySearchPaths>

		<!--And nowhere near bin\$(Configuration)\net48. That path is the DEPLOYABLE mod:
		    `make status` and `make deploy` compare its byte size against the copy in the
		    game's Mods folder to tell a landed deploy from a stale one. An output built
		    without the source generators and the post-processor must never be able to
		    stand in for it, and before this it did - a plain `dotnet build` under WSL
		    succeeds and writes there.-->
		<BaseOutputPath>bin\editor\</BaseOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!--Analyzer only: PrivateAssets keeps it out of the deployed mod.-->
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.177">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<!-- Needed only to READ Game.Prefabs.EconomyParameterData (the city's working hours for
		     the day/night shift classification): the struct carries a Colossal.Collections
		     AnimationCurve1 field, and the compiler needs the type to name the component. -->
		<Reference Include="Colossal.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Icons\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--The game loads <AssemblyName>.mjs and .css from the mod root, so these are
	    flattened out of Presentation/UI/ on copy.-->
	<ItemGroup>
		<None Include="Presentation\UI\WhereTheyGo.mjs" Link="WhereTheyGo.mjs" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Presentation\UI\WhereTheyGo.css" Link="WhereTheyGo.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--Reached only without the toolchain, so: either the fallback found nothing to bind
	    against and the 800-odd CS0246s that would follow are worth one message instead, or
	    it did and somebody is compiling a mod that cannot be deployed.-->
	<Target Name="CheckModToolchain" BeforeTargets="CoreCompile" Condition="'$(HasModToolchain)' != 'true'">
		<Error Code="WTG0001" Condition="'$(ManagedPath)' == ''"
		       Text="Neither CSII_TOOLPATH (set by the game's modding toolchain, and readable only by a Windows process) nor the game's Managed folder was found. Build the mod on Windows; see CLAUDE.md." />
		<!--A code, because a warning without one prints as a bare "warning :" and is the
		    one thing NoWarn and MSBuildWarningsAsMessages cannot name.-->
		<Warning Code="WTG0002" Condition="'$(DesignTimeBuild)' != 'true'"
		         Text="Compiling against $(ManagedPath) without the modding toolchain: no Entities source generators, no ModPostProcessor and no deploy. This output goes to $(OutputPath) for an editor to bind against; it is not a mod. Build on Windows to produce one." />
	</Target>

</Project>
