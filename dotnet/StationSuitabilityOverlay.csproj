<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<AssemblyName>StationSuitabilityOverlay</AssemblyName>
		<RootNamespace>StationSuitabilityOverlay</RootNamespace>
		<Authors>maxblan</Authors>
	
		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>

		<!--Checked arithmetic is deliberately OFF for the mod, and only for the mod.
		    SuitabilityJob and ExtractTripsJob are Burst-compiled and run per cell over
		    ~200k tiles; Burst does not support throwing, so an overflow check there is
		    either a compile failure or an abort, and the branch costs vectorization.
		    The test project (Directory.Build.props) keeps it on, and the pure math files
		    are compiled into BOTH — so overflow is still checked where it is reachable.-->
		<CheckForOverflowUnderflow>false</CheckForOverflowUnderflow>

		<!--Pins the analyzer package so a locked-mode restore (make strict) resolves
		    the same version on every machine.-->
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>
	
	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<!--Analyzer only: PrivateAssets keeps it out of the deployed mod.-->
		<PackageReference Include="Meziantou.Analyzer" Version="3.0.177">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Game">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<!-- Needed only to READ Game.Prefabs.EconomyParameterData (the city's working hours for
		     the day/night shift classification): the struct carries a Colossal.Collections
		     AnimationCurve1 field, and the compiler needs the type to name the component. -->
		<Reference Include="Colossal.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Icons\**" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--The game loads <AssemblyName>.mjs and .css from the mod root, so these are
	    flattened out of UI/ on copy.-->
	<ItemGroup>
		<None Include="UI\StationSuitabilityOverlay.mjs" Link="StationSuitabilityOverlay.mjs" CopyToOutputDirectory="PreserveNewest" />
		<None Include="UI\StationSuitabilityOverlay.css" Link="StationSuitabilityOverlay.css" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
