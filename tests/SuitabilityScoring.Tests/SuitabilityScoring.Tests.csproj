<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SuitabilityScoring.Tests</AssemblyName>
    <RootNamespace>StationSuitabilityOverlay.Tests</RootNamespace>
    <!-- No test framework package on purpose: this must run offline with nothing
         to restore. Failures are reported by a non-zero exit code. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- CS0649: TransitLine.m_RideSeconds is assigned in SuitabilityLines.cs, which is
         part of the mod and deliberately not linked here (it needs Unity types). Inside
         this project alone the field looks write-free. -->
    <!-- CA1515: ModePreset and RouteGoal are public because Setting exposes them
         through public properties the game's Options UI binds to by reflection. That
         reason does not exist in this console harness, which links the same file. -->
    <NoWarn>CS0649;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The mod's pure scoring math, shared rather than duplicated. It uses no
         Unity types precisely so it can be linked here. -->
    <Compile Include="../../dotnet/SuitabilityScoring.cs" Link="SuitabilityScoring.cs" />
    <Compile Include="../../dotnet/SuitabilityExactSites.cs" Link="SuitabilityExactSites.cs" />
    <Compile Include="../../dotnet/SuitabilityWalkAccess.cs" Link="SuitabilityWalkAccess.cs" />
    <Compile Include="../../dotnet/SuitabilityGraphMath.cs" Link="SuitabilityGraphMath.cs" />
    <Compile Include="../../dotnet/SuitabilityTransit.cs" Link="SuitabilityTransit.cs" />
    <Compile Include="../../dotnet/SuitabilityLineHistory.cs" Link="SuitabilityLineHistory.cs" />
    <Compile Include="../../dotnet/TransitMode.cs" Link="TransitMode.cs" />
    <Compile Include="../../dotnet/SuitabilityLineHealth.cs" Link="SuitabilityLineHealth.cs" />
    <!-- The verification export's wire format. Linked so the golden-vector test can
         pin it against verification/common/canonical.py, which refuses any file whose
         digest it cannot reproduce. -->
    <Compile Include="../../dotnet/SuitabilityExportJson.cs" Link="SuitabilityExportJson.cs" />
  </ItemGroup>

</Project>
