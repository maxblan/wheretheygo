<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SuitabilityScoring.Tests</AssemblyName>
    <RootNamespace>StationSuitabilityOverlay.Tests</RootNamespace>
    <!-- No test framework package on purpose: this must run offline with nothing
         to restore. Failures are reported by a non-zero exit code. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The mod's pure scoring math, shared rather than duplicated. It uses no
         Unity types precisely so it can be linked here. -->
    <Compile Include="../../dotnet/SuitabilityScoring.cs" Link="SuitabilityScoring.cs" />
  </ItemGroup>

</Project>
