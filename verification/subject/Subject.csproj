<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Subject</AssemblyName>
    <RootNamespace>TransitArchitect.Verification</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- CS0649: TransitLine.m_RideSeconds is assigned by Lines.cs, which
         needs Unity types and is not linked here — same situation as the test harness. -->
    <NoWarn>CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The system under test: the mod's pure core, linked UNCHANGED — the same
         linking the offline test harness uses. Nothing in this project reimplements
         mod logic; Program.cs is IO plus the argument wiring documented in
         docs/formal-specification.md. -->
    <Compile Include="../../dotnet/**/Planning/*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
